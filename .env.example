# Backend origin for the dev proxy. The browser only ever talks to the admin
# origin (/api/v1 is rewritten to this host), so httpOnly auth cookies work
# without CORS.
BACKEND_ORIGIN=http://localhost:3001

# Auth cookie names set by the backend (COOKIE_ACCESS_NAME / COOKIE_REFRESH_NAME).
# Defaults to boxify_access / boxify_refresh when unset.
# ADMIN_COOKIE_ACCESS_NAME=boxify_access
# ADMIN_COOKIE_REFRESH_NAME=boxify_refresh
